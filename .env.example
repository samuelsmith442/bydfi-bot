# BYDFi Trading Bot Configuration

# Trading Style (scalp, day, swing)
TRADING_STYLE=day

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Market Activity Thresholds
# Minimum total volume across all pairs (USD)
MIN_TOTAL_VOLUME=100000000

# Minimum average volume per pair (USD)  
MIN_AVG_VOLUME=500000

# Minimum number of active pairs
MIN_ACTIVE_PAIRS=20

# Minimum volume ratio to historical baseline
MIN_VOLUME_RATIO=1.5

# OpenAI API (Optional - for future AI features)
OPENAI_API_KEY=your_openai_api_key_here
